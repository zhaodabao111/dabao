APP_NAME=语音约碰面地点 API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8003
FRONTEND_ORIGIN=http://localhost:5175
PUBLIC_BASE_URL=http://localhost:8003
RECORDING_STORAGE_DIR=backend/storage/recordings
RECORDING_TTL_HOURS=24
AUDIO_MIN_DURATION_SECONDS=1
AUDIO_MAX_DURATION_SECONDS=60
AUDIO_MAX_SIZE_BYTES=5242880
AUDIO_PROBE_TIMEOUT_SECONDS=10
FFPROBE_BINARY=ffprobe

BAILIAN_API_KEY=
